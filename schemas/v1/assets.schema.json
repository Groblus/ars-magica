{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groblus.github.io/ars-magica/schemas/v1/assets.schema.json",
  "title": "Ars Magica publishing and media contracts v1",
  "$defs": {
    "printPreset": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["name", "page_size"], "properties": {"name": {"type": "string"}, "page_size": {"type": "string"}, "bleed_mm": {"type": "number", "minimum": 0}, "safe_margin_mm": {"type": "number", "minimum": 0}, "color_space": {"type": "string"}, "pdf_standard": {"type": ["string", "null"]}}}]},
    "artifactSpec": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["template_id", "title"], "properties": {"template_id": {"type": "string"}, "title": {"type": "string"}, "audience": {"type": "string"}, "content_ids": {"type": "array", "items": {"type": "string"}}, "print_preset_id": {"type": ["string", "null"]}, "style_profile_id": {"type": ["string", "null"]}, "data": {"type": "object"}}}]},
    "mapSpec": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["title", "map_kind"], "properties": {"title": {"type": "string"}, "map_kind": {"type": "string"}, "projection": {"type": ["string", "null"]}, "extent": {"type": "array", "items": {"type": "number"}}, "layers": {"type": "array", "items": {"type": "object"}}}}]},
    "mediaAsset": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["kind", "title", "uri"], "properties": {"kind": {"enum": ["image", "audio", "svg", "document"]}, "title": {"type": "string"}, "uri": {"type": "string"}, "entity_id": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}, "license_id": {"type": ["string", "null"]}, "generation_run_id": {"type": ["string", "null"]}}}]},
    "styleProfile": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "token_overrides": {"type": "object"}, "palette": {"type": "object"}, "typography": {"type": "object"}}}]},
    "generationRun": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["provider"], "properties": {"provider": {"type": "string"}, "model": {"type": ["string", "null"]}, "prompt_hash": {"type": ["string", "null"]}, "seed": {"type": ["integer", "null"]}, "parameters": {"type": "object"}}}]},
    "licenseRecord": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "license_identifier": {"type": ["string", "null"]}, "commercial_use": {"type": ["boolean", "null"]}, "redistribution": {"type": ["boolean", "null"]}}}]},
    "consentRecord": {"allOf": [{"$ref": "common.schema.json#/$defs/record"}, {"type": "object", "required": ["subject_id", "granted_by"], "properties": {"subject_id": {"type": "string"}, "scope": {"type": "array", "items": {"type": "string"}}, "granted_by": {"type": "string"}, "revoked": {"type": "boolean"}}}]}
  },
  "oneOf": [{"$ref": "#/$defs/printPreset"}, {"$ref": "#/$defs/artifactSpec"}, {"$ref": "#/$defs/mapSpec"}, {"$ref": "#/$defs/mediaAsset"}, {"$ref": "#/$defs/styleProfile"}, {"$ref": "#/$defs/generationRun"}, {"$ref": "#/$defs/licenseRecord"}, {"$ref": "#/$defs/consentRecord"}]
}
